# 新克隆工程时的默认配置（sdkconfig 已存在时不会被使用）
# 用法：删除 sdkconfig 后 `idf.py reconfigure`，IDF 会以本文件为默认值重新生成。

# ---- 目标芯片 ----
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash：ESP32-S3-WROOM-1 N16R8 = 16MB Flash + 8MB PSRAM ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# ---- 分区表：使用工程自带 partitions.csv ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- 系统 ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=100

# ---- 控制台：UART0 + 可选 USB-JTAG 副控制台 ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- 组件裁剪（减少编译时间/体积）----

# SD 卡记录需要长文件名（默认是 NONE，只剩 8.3 短名可用）
CONFIG_FATFS_LFN_HEAP=y

# WiFi Enterprise (WPA2-EAP/PEAP) for campus networks
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y

# ---- BT: Netlea BLE lamp (NimBLE GATT client) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# WiFi + BLE coexistence (lamp and MQTT must work together)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
