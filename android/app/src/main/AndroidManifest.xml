<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- AR 眼镜（Rokid CXR-L）需要：蓝牙权限 + 能看到 Rokid AI App 的包可见性。
         没有这些，checkRokidAppCompatibility / 建会话都会失败。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <queries>
        <package android:name="com.rokid.sprite.aiapp" />
        <package android:name="com.rokid.sprite.global.aiapp" />
        <package android:name="com.rokid.uxr" />
    </queries>

    <!--
      usesCleartextTraffic="true" 是必须的：
      控制台默认用 ws://（明文 WebSocket），Android 9+ 默认禁止明文流量。
      如果改用 wss:// 就可以删掉这一行。
    -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.FishTank">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
